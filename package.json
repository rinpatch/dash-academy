{
  "name": "dash-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:isolated": "portless run --name dash-academy next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lessons": "node scripts/lessons.mjs",
    "lessons:validate": "node scripts/lessons.mjs validate",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "platform:create-identity": "node --env-file-if-exists=.env.local scripts/platform/create-identity.mjs",
    "platform:register-contract": "node --env-file-if-exists=.env.local scripts/platform/register-contract.mjs",
    "platform:measure-fees": "node --env-file-if-exists=.env.local scripts/platform/measure-fees.mjs"
  },
  "dependencies": {
    "@dashevo/evo-sdk": "4.1.1",
    "@dashevo/wasm-sdk": "4.1.1",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.11.4",
    "fumadocs-mdx": "^15.1.1",
    "fumadocs-ui": "^16.11.4",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "agent-browser": "0.34.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "portless": "0.15.5",
    "tailwindcss": "4.3.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
