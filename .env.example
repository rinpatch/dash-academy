# Progress sync — all optional. With none of these set the academy runs exactly as before:
# lessons work, progress persists in localStorage, and the sync control hides itself.

# testnet (default) or mainnet. Lesson labs always verify against testnet regardless;
# this is the network progress records and certificates live on.
DASH_NETWORK=testnet

# The academy's Platform identity — it owns the contract and signs every progress write.
DASH_ACADEMY_IDENTITY_ID=
DASH_ACADEMY_PRIVATE_KEY_WIF=

# From `npm run platform:register-contract`. Run that once per network.
DASH_ACADEMY_CONTRACT_ID=

# Salt for learner record keys, >=16 chars. The passkey-derived key never reaches the chain;
# this HMACs it into the public identifier, so scraping the contract reveals nothing usable.
# Changing it orphans every existing record.
DASH_LEARNER_KEY_SALT=

# Signs the session cookie, >=16 chars. Changing it signs everyone out.
DASH_SESSION_SECRET=
