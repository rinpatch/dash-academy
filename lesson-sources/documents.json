  "claims": [
    {
      "id": "C1",
      "text": "A document is an instance of a contract-defined document type and combines application properties with Platform metadata such as ID, type, contract ID, owner ID, and revision.",
      "sourceIds": ["S2", "S7", "S10"],
      "support": "direct"
    },
    {
      "id": "C2",
      "text": "Reads identify a contract and document type and may add filters, ordering, limits, or pagination; they query current state without a signer.",
      "sourceIds": ["S4", "S13", "S14"],
      "support": "direct"
    },
    {
      "id": "C3",
      "text": "Create, replace, and delete writes use signed batch state transitions that Platform validates against protocol and contract rules before changing state.",
      "sourceIds": ["S2", "S3", "S7", "S11"],
      "support": "direct"
    },
    {
      "id": "C4",
      "text": "The current document owner, contract owner, and original creator are distinct roles; transfer can make the current owner differ from the creator.",
      "sourceIds": ["S7", "S10"],
      "support": "direct"
    },
    {
      "id": "C5",
      "text": "A document type can allow unrestricted creation, contract-owner-only creation, or no creation, independently of individual document ownership.",
      "sourceIds": ["S8"],
      "support": "direct"
    },
    {
      "id": "C6",
      "text": "Platform loads existing state to authorize replacement and deletion, and only the current document owner can delete a document.",
      "sourceIds": ["S6", "S11"],
      "support": "direct"
    },
    {
      "id": "C7",
      "text": "Updating a mutable document is a complete replacement that preserves the ID and advances the current revision by one.",
      "sourceIds": ["S5", "S14"],
      "support": "direct"
    },
    {
      "id": "C8",
      "text": "The next-revision check provides optimistic concurrency protection by rejecting a replacement built from stale state.",
      "sourceIds": ["S5", "S11", "S14"],
      "support": "inference"
    },
    {
      "id": "C9",
      "text": "Revision tracking does not imply retained prior bodies; document history is disabled by default and must be configured by the contract.",
      "sourceIds": ["S8", "S10", "S14"],
      "support": "direct"
    },
    {
      "id": "C10",
      "text": "Deletion is available only when allowed by the document type, and Platform resolves the existing document during validation.",
      "sourceIds": ["S6", "S8", "S11", "S14"],
      "support": "direct"
    },
    {
      "id": "C11",
      "text": "Deleting stored data may return the still-undistributed portion of its attributed storage fee, and the amount decreases as epochs elapse.",
      "sourceIds": ["S9", "S12"],
      "support": "direct"
    },
    {
      "id": "C12",
      "text": "A deletion refund is not the complete original write cost because processing fees are non-refundable and only available storage value is subtracted.",
      "sourceIds": ["S9", "S12"],
      "support": "direct"
    },
    {
      "id": "C13",
      "text": "The pinned SDK exposes document query, get, create, replace, and delete operations, and represents document revisions as bigint values.",
      "sourceIds": ["S13", "S14"],
      "support": "direct"
    }
  ],
