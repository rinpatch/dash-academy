{
  "schemaVersion": 1,
  "courseId": "dash-platform",
  "targets": {
    "coreDocs": "23.0.0",
    "platformDocs": "3.1.0",
    "platformBook": "v4.2-dev",
    "evoSdk": "4.1.1",
    "wasmSdk": "4.1.1"
  },
  "lessons": [
    {
      "module": 1,
      "slug": "what-is-dash-platform",
      "title": "What is Dash Platform?",
      "tier": "concepts",
      "description": "Meet Dash, and see what Dash Platform lets you build.",
      "estimatedMinutes": 12,
      "exp": 100,
      "prerequisites": [],
      "verification": { "kind": "quiz", "challengeId": "what-is-dash-platform" },
      "mustCover": ["what a blockchain network gives an app developer", "Dash Core for money and Dash Platform for app data", "payments confirm in about a second, and what that buys you", "concrete things you can build", "what you will build in this course"],
      "mustNotCover": ["masternode quorums and LLMQs", "InstantSend versus ChainLock mechanics", "Tenderdash and consensus internals"]
    },
    {
      "module": 2,
      "slug": "why-build-on-dash",
      "title": "Why build on Dash?",
      "tier": "concepts",
      "description": "Decide when Dash is a good fit for an application.",
      "estimatedMinutes": 12,
      "exp": 100,
      "prerequisites": ["what-is-dash-platform"],
      "verification": { "kind": "quiz", "challengeId": "why-build-on-dash" },
      "mustCover": ["fit and non-fit", "payments and tokens", "usernames and NFTs", "Dash versus Credits", "privacy", "DAO"]
    },
    {
      "module": 3,
      "slug": "identities",
      "title": "Identities",
      "tier": "concepts",
      "description": "Understand Platform identities, keys, credits, and their relationship to wallets.",
      "estimatedMinutes": 12,
      "exp": 100,
      "prerequisites": ["why-build-on-dash"],
      "verification": { "kind": "quiz", "challengeId": "identities" },
      "mustCover": ["identity versus wallet address", "identity keys", "credits and fees"]
    },
    {
      "module": 4,
      "slug": "data-contracts",
      "title": "Data Contracts",
      "tier": "concepts",
      "description": "Model application data with document types and indexes.",
      "estimatedMinutes": 14,
      "exp": 100,
      "prerequisites": ["identities"],
      "verification": { "kind": "quiz", "challengeId": "data-contracts" },
      "mustCover": ["schemas", "document types", "indexes", "contract-time decisions", "no triggers or joins"]
    },
    {
      "module": 5,
      "slug": "documents",
      "title": "Documents",
      "tier": "concepts",
      "description": "Understand the lifecycle, ownership, and revision of Platform documents.",
      "estimatedMinutes": 14,
      "exp": 100,
      "prerequisites": ["data-contracts"],
      "verification": { "kind": "quiz", "challengeId": "documents" },
      "mustCover": ["read and write lifecycle", "ownership", "revisions", "delete refunds"]
    },
    {
      "module": 6,
      "slug": "dapi",
      "title": "DAPI",
      "tier": "concepts",
      "description": "Understand Dash's decentralized API and how clients use it.",
      "estimatedMinutes": 10,
      "exp": 100,
      "prerequisites": ["documents"],
      "verification": { "kind": "quiz", "challengeId": "dapi" },
      "mustCover": ["decentralized API", "Core and Platform access", "endpoint selection"]
    },
    {
      "module": 7,
      "slug": "proofs",
      "title": "Proofs",
      "tier": "concepts",
      "description": "Verify Platform responses instead of trusting a single server.",
      "estimatedMinutes": 12,
      "exp": 100,
      "prerequisites": ["dapi"],
      "verification": { "kind": "quiz", "challengeId": "proofs" },
      "mustCover": ["state proofs", "light-client trust", "verification boundaries"]
    },
    {
      "module": 8,
      "slug": "environment-setup",
      "title": "Environment setup",
      "tier": "sdk",
      "description": "Install the SDK, connect to Dash Platform, and make a verified read.",
      "estimatedMinutes": 18,
      "exp": 150,
      "prerequisites": ["proofs"],
      "verification": { "kind": "testnet", "challengeId": "environment-setup", "operation": "verified-read" },
      "mustCover": ["install Evo SDK", "connect to testnet", "read from live DAPI"]
    },
    {
      "module": 9,
      "slug": "fund-a-platform-address",
      "title": "Fund a Platform address",
      "tier": "sdk",
      "description": "Derive and fund a Platform address for identity creation.",
      "estimatedMinutes": 20,
      "exp": 175,
      "prerequisites": ["environment-setup"],
      "verification": { "kind": "testnet", "challengeId": "fund-a-platform-address", "operation": "funded-address" },
      "mustCover": ["DIP-18 derivation", "bech32m Platform address", "funding", "identity funding path"]
    },
    {
      "module": 10,
      "slug": "create-a-dash-identity",
      "title": "Create a Dash Identity",
      "tier": "sdk",
      "description": "Create and verify a Dash Platform identity on testnet.",
      "estimatedMinutes": 20,
      "exp": 200,
      "prerequisites": ["fund-a-platform-address"],
      "verification": { "kind": "testnet", "challengeId": "create-a-dash-identity", "operation": "identity-create" },
      "mustCover": ["identity creation", "key purposes and security levels", "credit balance"]
    },
    {
      "module": 11,
      "slug": "register-a-username",
      "title": "Register a Username (DPNS)",
      "tier": "sdk",
      "description": "Preorder and register a DPNS name.",
      "estimatedMinutes": 22,
      "exp": 200,
      "prerequisites": ["create-a-dash-identity"],
      "verification": { "kind": "testnet", "challengeId": "register-a-username", "operation": "dpns-register" },
      "mustCover": ["preorder and registration", "salt handling", "premium-name voting"]
    },
    {
      "module": 12,
      "slug": "write-your-first-data-contract",
      "title": "Write your first Data Contract",
      "tier": "sdk",
      "description": "Design and publish a small data contract.",
      "estimatedMinutes": 28,
      "exp": 250,
      "prerequisites": ["register-a-username"],
      "verification": { "kind": "hybrid", "quizChallengeId": "write-your-first-data-contract:quiz", "challengeId": "write-your-first-data-contract", "operation": "contract-create" },
      "mustCover": ["document schema", "indexes", "contract registration"]
    },
    {
      "module": 13,
      "slug": "submit-a-document",
      "title": "Submit a Document",
      "tier": "sdk",
      "description": "Create and submit a document to a deployed contract.",
      "estimatedMinutes": 22,
      "exp": 200,
      "prerequisites": ["write-your-first-data-contract"],
      "verification": { "kind": "testnet", "challengeId": "submit-a-document", "operation": "document-create" },
      "mustCover": ["document creation", "state transition", "ownership and fees"]
    },
    {
      "module": 14,
      "slug": "query-documents",
      "title": "Query Documents",
      "tier": "sdk",
      "description": "Query indexed documents and reason about query constraints.",
      "estimatedMinutes": 25,
      "exp": 225,
      "prerequisites": ["submit-a-document"],
      "verification": { "kind": "hybrid", "quizChallengeId": "query-documents:quiz", "challengeId": "query-documents", "operation": "document-query" },
      "mustCover": ["filters", "sorting", "range constraints", "v4 aggregation"]
    },
    {
      "module": 15,
      "slug": "document-transfer-and-purchase",
      "title": "Document Transfer and Purchase",
      "tier": "sdk",
      "description": "Transfer documents and implement Platform purchase flows.",
      "estimatedMinutes": 28,
      "exp": 250,
      "prerequisites": ["query-documents"],
      "verification": { "kind": "hybrid", "quizChallengeId": "document-transfer-and-purchase:quiz", "challengeId": "document-transfer-and-purchase", "operation": "document-transfer-purchase" },
      "mustCover": ["transfer", "purchase", "price updates", "ownership checks"]
    },
    {
      "module": 16,
      "slug": "tokens",
      "title": "Tokens",
      "tier": "sdk",
      "description": "Configure and operate a native Platform token.",
      "estimatedMinutes": 30,
      "exp": 275,
      "prerequisites": ["document-transfer-and-purchase"],
      "verification": { "kind": "hybrid", "quizChallengeId": "tokens:quiz", "challengeId": "tokens", "operation": "token-actions" },
      "mustCover": ["token configuration", "action set", "groups", "mint and transfer"]
    },
    {
      "module": 17,
      "slug": "token-paid-document-creation",
      "title": "Token-paid document creation",
      "tier": "sdk",
      "description": "Charge tokens for document operations and test the resulting economics.",
      "estimatedMinutes": 30,
      "exp": 300,
      "prerequisites": ["tokens"],
      "verification": { "kind": "hybrid", "quizChallengeId": "token-paid-document-creation:quiz", "challengeId": "token-paid-document-creation", "operation": "token-paid-documents" },
      "mustCover": ["tokenCost for six document operations", "transfer and burn effects", "sponsored gas", "flags"]
    }
  ]
}
